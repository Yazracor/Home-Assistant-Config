{
  "files.associations": {
    "scripts.yaml": "yaml",
    "*.yaml": "home-assistant",
    "compose.yml": "yaml",
    "compose.yaml": "yaml",
    "compose.*.yml": "yaml",
    "compose.*.yaml": "yaml",
    "docker-compose.yml": "yaml",
    "docker-compose.yaml": "yaml",
    "docker-compose.*.yml": "yaml",
    "docker-compose.*.yaml": "yaml",
    "esphome/**/*.yml": "esphome",
    "esphome/**/*.yaml": "esphome"
  },
  "yaml.customTags": [
    "!include scalar",
    "!include_dir_named scalar",
    "!include_dir_merge_named scalar",
    "!include_dir_merge_list scalar",
    "!include_dir_list scalar",
    "!env_var scalar",
    "!secret scalar"
  ],
  "files.exclude": {
    "**/.DS_Store": false,
    "**/Thumbs.db": false,
    "**/.storage": false
  },
  "search.exclude": {
    "**/.DS_Store": false,
    "**/Thumbs.db": false,
    "**/.storage": false
  },
  "explorer.excludeGitIgnore": false
}
