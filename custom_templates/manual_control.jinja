{% macro manual_override_seconds(returns) %}
  {% do returns(4 * 3600) %}
{% endmacro %}

{% macro cover_manual_blocked(cover, returns) %}
  {% from 'hitzeschutz_manual_generated.jinja' import related_covers %}
  {% set related = related_covers | as_function %}
  {% set duration = manual_override_seconds | as_function %}
  {% set entries = state_attr('sensor.hitzeschutz_manueller_jalousie_block', 'blocked_since') | default({}, true) %}
  {% set ns = namespace(blocked=states('sensor.hitzeschutz_manueller_jalousie_block') in ['unknown', 'unavailable']) %}
  {% for entity in related().get(cover, [cover]) %}
    {% set last_manual = entries.get(entity, '') | as_timestamp(0) %}
    {% set ns.blocked = ns.blocked or (last_manual > 0 and as_timestamp(now()) - last_manual < duration()) %}
  {% endfor %}
  {% do returns(ns.blocked) %}
{% endmacro %}

{% macro manual_cover_entities(trigger_id, event_data, context_user_id, context_id, returns) %}
  {% from 'hitzeschutz_manual_generated.jinja' import knx_cover_map %}
  {% set knx_map = knx_cover_map | as_function %}
  {% set touched = touched_entities | as_function %}
  {% set covers = states.cover | map(attribute='entity_id') | reject('eq', 'cover.aussenbereich_garage_garagentor') | list %}
  {% set command = states.script.hitzeschutz_jalousie_automatisieren %}
  {# Auch explizit vom Benutzer gestartete Automatik-Scripts erzeugen eigene Serviceaufrufe. #}
  {% set own_service = trigger_id == 'service' and command is not none and command.state == 'on' and context_id == command.context.id %}
  {% do returns([] if own_service else touched(trigger_id, event_data, context_user_id, covers, knx_map(), 'cover', false)) %}
{% endmacro %}

{% macro touched_entities(trigger_id, event_data, context_user_id, allowed_entities, knx_map, domain, require_brightness, returns) %}
  {% set ns = namespace(items=[]) %}
  {% set allowed = allowed_entities | from_json(default=allowed_entities) if allowed_entities is string else allowed_entities %}

  {% if trigger_id == 'knx' %}
    {% set ignored_sources = ['15.15.250', '1.1.15'] %}
    {% set address = event_data.destination | string %}
    {% set source = event_data.source | string %}
    {% set direction = event_data.direction | string %}
    {% if direction == 'Incoming' and source not in ignored_sources %}
      {% set ns.items = knx_map.get(address, []) %}
    {% endif %}

  {% elif trigger_id == 'homekit' %}
    {% set entity = event_data.entity_id | default('', true) %}
    {% if entity is string and entity in allowed %}
      {% set ns.items = [entity] %}
    {% endif %}

  {% elif trigger_id == 'service' %}
    {% set service_data = event_data.service_data | default({}, true) %}
    {% set has_brightness = (
      'brightness' in service_data
      or 'brightness_pct' in service_data
      or 'brightness_step' in service_data
      or 'brightness_step_pct' in service_data
    ) %}
    {% if context_user_id is not none and event_data.domain == domain and (not require_brightness or has_brightness) %}
      {% set raw_entities = service_data.entity_id | default([], true) %}
      {% if raw_entities is string %}
        {% set entities = [raw_entities] %}
      {% elif raw_entities is iterable %}
        {% set entities = raw_entities | list %}
      {% else %}
        {% set entities = [] %}
      {% endif %}
      {% for entity in entities if entity in allowed %}
        {% set ns.items = ns.items + [entity] %}
      {% endfor %}
    {% endif %}
  {% endif %}

  {% do returns(ns.items | unique | list) %}
{% endmacro %}
