{% macro energy_request(room, returns) %}
  {% set heat = states('binary_sensor.' ~ room ~ '_anforderung_heizen') %}
  {% set cool = states('binary_sensor.' ~ room ~ '_anforderung_kuhlen') %}
  {% set heat_cool = states('binary_sensor.heizen_kuehlen_rueckmeldung') %}
  {% if heat_cool == 'off' and cool == 'on' %}
    {% do returns('kuehlen') %}
  {% elif heat_cool == 'on' and heat == 'on' %}
    {% do returns('heizen') %}
  {% elif cool == 'on' and heat != 'on' %}
    {% do returns('kuehlen') %}
  {% elif heat == 'on' and cool != 'on' %}
    {% do returns('heizen') %}
  {% elif heat == 'off' and cool == 'off' %}
    {% do returns('keine') %}
  {% else %}
    {% do returns('unbekannt') %}
  {% endif %}
{% endmacro %}

{% macro energy_icon(room, returns) %}
  {% set request = energy_request | as_function %}
  {% set icons = {
    'heizen': 'mdi:fire',
    'kuehlen': 'mdi:snowflake'
  } %}
  {% do returns(icons.get(request(room), 'mdi:thermostat')) %}
{% endmacro %}

{% macro mode_sensors(returns) %}
  {% do returns([
    'sensor.og_schlafzimmer_betriebsmodus',
    'sensor.og_bad_betriebsmodus',
    'sensor.og_buro_betriebsmodus',
    'sensor.og_ankleide_betriebsmodus',
    'sensor.eg_flur_betriebsmodus',
    'sensor.eg_arbeitszimmer_betriebsmodus',
    'sensor.eg_arbeitszimmer_flur_betriebsmodus',
    'sensor.eg_gaestebad_betriebsmodus',
    'sensor.eg_gaeste_wc_betriebsmodus',
    'sensor.eg_garderobe_betriebsmodus',
    'sensor.eg_technik_betriebsmodus',
    'sensor.eg_kueche_betriebsmodus',
    'sensor.eg_wohnzimmer_betriebsmodus',
    'sensor.kg_flur_betriebsmodus',
    'sensor.kg_gast_hobby_betriebsmodus',
    'sensor.kg_kinderbad_betriebsmodus',
    'sensor.kg_zimmer_sinja_betriebsmodus',
    'sensor.kg_zimmer_silas_betriebsmodus'
  ]) %}
{% endmacro %}

{% macro expected_mode(returns) %}
  {% do returns('1' if is_state('binary_sensor.heizen_kuehlen_rueckmeldung', 'on') else '3') %}
{% endmacro %}

{% macro expected_mode_label(returns) %}
  {% if is_state('binary_sensor.heizen_kuehlen_rueckmeldung', 'on') %}
    {% do returns('heizen') %}
  {% elif is_state('binary_sensor.heizen_kuehlen_rueckmeldung', 'off') %}
    {% do returns('kuehlen') %}
  {% else %}
    {% do returns('unbekannt') %}
  {% endif %}
{% endmacro %}

{% macro central_switching_ok(returns) %}
  {% set expected = expected_mode | as_function %}
  {% set sensors = mode_sensors | as_function %}
  {% do returns(expand(sensors()) | rejectattr('state', 'eq', expected()) | list | count == 0) %}
{% endmacro %}

{% macro deviating_thermostats(returns) %}
  {% set expected = expected_mode | as_function %}
  {% set sensors = mode_sensors | as_function %}
  {% set labels = {
    '0': 'auto',
    '1': 'heizen',
    '3': 'kuehlen',
    '6': 'aus',
    'unknown': 'unbekannt',
    'unavailable': 'nicht verfuegbar'
  } %}
  {% set ns = namespace(items=[]) %}
  {% for mode_sensor in expand(sensors()) %}
    {% if mode_sensor.state != expected() %}
      {% set mode = labels.get(mode_sensor.state, mode_sensor.state) %}
      {% set ns.items = ns.items + [mode_sensor.name ~ ' (' ~ mode ~ ')'] %}
    {% endif %}
  {% endfor %}
  {% do returns(ns.items) %}
{% endmacro %}
