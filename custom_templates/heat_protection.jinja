      'shade_height_m': 3,
      'shade_floor_axis_azimuth': 205,
      'shade_wall_reference_drop_m': 1.5,
      'shade_wall_axes': [205, 295],
      'min_shadow_coverage': 0,
      'horizontal_shade': true
    },
    'ost': {
      'name': 'Fassade Ost',
      'display_name': 'Ostseite',
      'sensor': 'binary_sensor.hitzeschutz_fassade_ost',
