  }) %}
{% endmacro %}

{% macro facade_config(facade, returns) %}
  {% set configs = facade_configs | as_function %}
  {% do returns(configs().get(facade, {})) %}
{% endmacro %}

{% macro facade_config_for_sensor(sensor, returns) %}
  {% set configs = facade_configs | as_function %}
  {% set ns = namespace(config={}) %}
  {% for config in configs().values() %}
    {% if config.sensor == sensor %}
      {% set ns.config = config %}
    {% endif %}
  {% endfor %}
  {% do returns(ns.config) %}
{% endmacro %}

{% macro facade_name(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% do returns(config(facade).get('name', facade)) %}
{% endmacro %}

{% macro facade_display_name(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% do returns(config(facade).get('display_name', config(facade).get('name', facade))) %}
{% endmacro %}

{% macro facade_covers(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% do returns(config(facade).get('covers', [])) %}
{% endmacro %}

{% macro facade_azimuth(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% do returns(config(facade).get('azimuth')) %}
{% endmacro %}

{% macro horizontal_shadow_coverage(facade, axis, drop, returns) %}
  {% set config = facade_config | as_function %}
  {% set facade_settings = config(facade) %}
  {% set elevation = state_attr('sun.sun', 'elevation') | float(0) %}
  {% if not facade_settings.horizontal_shade | default(false) or elevation <= 0 %}
    {% do returns(0) %}
  {% else %}
    {% set azimuth = state_attr('sun.sun', 'azimuth') | float(0) %}
    {% set size = facade_settings.shade_size_m | default(6) | float(6) %}
    {% set drop = drop | float(0) %}
    {% set elevation_rad = elevation * 3.141592653589793 / 180 %}
    {% set axis_delta_rad = (((azimuth - (axis | float(0)) + 180) % 360) - 180) * 3.141592653589793 / 180 %}
    {% set shadow_offset = drop / (elevation_rad | tan) %}
    {% set offset_x = (shadow_offset * (axis_delta_rad | cos)) | abs %}
    {% set offset_y = (shadow_offset * (axis_delta_rad | sin)) | abs %}
    {% set overlap_x = [0, size - offset_x] | max %}
    {% set overlap_y = [0, size - offset_y] | max %}
    {% do returns(overlap_x * overlap_y / (size * size)) %}
  {% endif %}
{% endmacro %}

{% macro floor_shadow_coverage(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% set facade_settings = config(facade) %}
  {% set coverage = horizontal_shadow_coverage | as_function %}
  {% set axis = facade_settings.shade_floor_axis_azimuth | default(facade_settings.azimuth) %}
  {% set drop = facade_settings.shade_height_m | default(3) %}
  {% do returns(coverage(facade, axis, drop)) %}
{% endmacro %}

{% macro wall_shadow_coverage(facade, axis, returns) %}
  {% set config = facade_config | as_function %}
  {% set facade_settings = config(facade) %}
  {% set coverage = horizontal_shadow_coverage | as_function %}
  {% set azimuth = state_attr('sun.sun', 'azimuth') | float(0) %}
  {% set delta = (((azimuth - (axis | float(0)) + 180) % 360) - 180) | abs %}
  {% set drop = facade_settings.shade_wall_reference_drop_m | default(1.5) %}
  {% do returns(coverage(facade, axis, drop) if delta < 90 else 0) %}
{% endmacro %}

{% macro horizontal_shade_coverage(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% set facade_settings = config(facade) %}
  {% set floor_coverage = floor_shadow_coverage | as_function %}
  {% set wall_coverage = wall_shadow_coverage | as_function %}
  {% set ns = namespace(value=floor_coverage(facade)) %}
  {% for axis in facade_settings.shade_wall_axes | default([]) %}
    {% set ns.value = [ns.value, wall_coverage(facade, axis)] | max %}
  {% endfor %}
  {% do returns(ns.value) %}
{% endmacro %}

{% macro sun_lux_threshold(returns) %}
  {% do returns(30000) %}
{% endmacro %}

{% macro sun_lux(returns) %}
  {% set horizontal_lux = states('sensor.aussenbereich_wetterstation_helligkeit') | float(0) %}
  {% set elevation = state_attr('sun.sun', 'elevation') | float(0) %}
  {% if elevation <= 0 %}
    {% do returns(0) %}
  {% else %}
    {% set elevation_rad = elevation * 3.141592653589793 / 180 %}
    {% set normalized_lux = horizontal_lux / (elevation_rad | sin) %}
    {% do returns(([0, normalized_lux, 120000] | sort)[1]) %}
  {% endif %}
{% endmacro %}

{% macro facade_lux(facade, returns) %}
  {% set normalized_lux = sun_lux | as_function %}
  {% do returns(normalized_lux()) %}
{% endmacro %}

{% macro facade_sun_exposed(facade, returns) %}
  {% set config = facade_config | as_function %}
  {% set facade_settings = config(facade) %}
  {% set azimuth = state_attr('sun.sun', 'azimuth') | float(0) %}
  {% set elevation = state_attr('sun.sun', 'elevation') | float(0) %}
  {% set delta = (((azimuth - facade_settings.azimuth + 180) % 360) - 180) | abs %}
  {% set shade_coverage = horizontal_shade_coverage | as_function %}
  {% set sun_position_ok = (
    is_state('sun.sun', 'above_horizon')
    and elevation > (facade_settings.min_elevation | default(0))
  ) %}
  {% set facade_rule_active = (
    sun_position_ok
    and delta < facade_settings.max_delta
  ) %}
  {% set floor_rule_active = (
    facade_settings.horizontal_shade | default(false)
    and sun_position_ok
    and shade_coverage(facade) > facade_settings.min_shadow_coverage | default(0)
  ) %}
  {% do returns((not facade_settings.horizontal_shade | default(false) and facade_rule_active) or floor_rule_active) %}
{% endmacro %}

{% macro facade_active(facade, returns) %}
  {% set sun_exposed = facade_sun_exposed | as_function %}
  {% set corrected_lux = sun_lux | as_function %}
  {% set threshold = sun_lux_threshold | as_function %}
  {% do returns(sun_exposed(facade) and corrected_lux() > threshold()) %}
{% endmacro %}
