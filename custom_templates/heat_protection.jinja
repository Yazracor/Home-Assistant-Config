        'cover.eg_arbeitszimmer_vorgarten'
      ],
      'azimuth': 115,
      'max_delta': 80
    },
    'sued': {
      'name': 'Fassade Sued',
      'display_name': 'Südseite',
      'sensor': 'binary_sensor.hitzeschutz_fassade_sud',
      'covers': [
        'cover.eg_wohnzimmer_balkon',
        'cover.eg_kueche_seite',
        'cover.eg_kueche_nebeneingang',
        'cover.og_schlafzimmer_panorama_aussen',
        'cover.og_bad_balkon',
        'cover.og_bad_balkon_innen',
        'cover.eg_arbeitszimmer_garten'
      ],
      'azimuth': 205,
      'max_delta': 90
    },
    'nord': {
      'name': 'Fassade Nord',
      'display_name': 'Nordseite',
      'sensor': 'binary_sensor.hitzeschutz_fassade_nord',
      'covers': [
        'cover.og_ankleide_fenster',
        'cover.og_buro_fenster',
