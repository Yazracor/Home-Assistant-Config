#!/bin/sh
set -eu

PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/bin:/config:${PATH:-}"
export PATH

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
log_file="$repo_root/.git/hooks/post-merge.log"
marker_file="$repo_root/.pending_knx_area_assignment"
runner="$repo_root/devscripts/apply-pending-knx-area-assignments.sh"
runner_log="$repo_root/.knx-area-assignment.log"
delay_seconds="${KNX_AREA_ASSIGNMENT_DELAY_SECONDS:-10}"

{
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') post-merge hook started in $repo_root"
  echo "PATH=$PATH"
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$marker_file"
  echo "Marked pending KNX area assignment: $marker_file"
  if [ -x "$runner" ]; then
    (
      sleep "$delay_seconds"
      exec "$runner"
    ) >> "$runner_log" 2>&1 &
    echo "Started detached KNX area assignment runner after ${delay_seconds}s: $runner"
    echo "Runner log: $runner_log"
  else
    echo "Runner not executable: $runner"
  fi
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') post-merge hook finished"
} >> "$log_file" 2>&1
